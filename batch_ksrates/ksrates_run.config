// Default resources of the per-dataset ksrates pipelines launched by stage 4 (--execute_real_pipelines),
// i.e. of the processes of ksrates/main.nf. Passed to those pipelines with -c, after the config main.nf
// generates (container, bind mounts, PYTHONPATH).
//
// To change them for one analysis, copy this file next to that analysis' nextflow.config, edit it, and set
//     params.ksrates_run_config = "/path/to/your/ksrates_run.config"
// in the analysis' nextflow.config.

executor {
    name = 'slurm'
}

process {
    withName: 'wgdParalogs' {
        cpus = 4                // same as params.paralog_threads
        memory = '8GB'
    }
    withName: 'wgdOrthologs' {
        cpus = 4                // same as params.ortholog_threads
        memory = '4GB'
    }
    withName: 'estimatePeaks' {
        memory = '4GB'
    }
    withName: 'paralogsAnalyses' {
        memory = '8GB'
    }
    withName: 'plotOrthologDistrib' {
        memory = '2GB'
    }
}
