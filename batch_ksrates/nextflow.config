// Default configuration of the batch_ksrates wrapper (main.nf). main.nf contains only the logic:
// every parameter and every process setting lives here.
//
// To adapt it for one analysis, do NOT edit this file:
// put a nextflow.config in the directory the pipeline is launched from, containing only what differs.
// Nextflow loads it automatically and it overrides the defaults below. Order of priority, highest
// first: command-line --params, -c files, nextflow.config in the launch directory, this file.

params {
    // ---- Required (set them in the analysis' own nextflow.config)
    base_dir = null                     // output base directory of the analysis
    transcriptomes_dir = "/group/esb/cesen/1kp/source_data/2.transcriptomes/1kp/cngb_transcriptomes"

    // ---- Inputs of generate_species_metadata.py and make_branch_subtrees.py (same defaults as those scripts)
    species_table = "/group/esb/cesen/1kp/source_data/1.species_dataset/1kp_paper_2019_suptab1_species.tsv"
    tree = "/group/esb/cesen/1kp/source_data/3.phylogenetic_tree/1kp_trees/astral_trees_33_percent-FAA_estimated_species_tree.rooted.wgm_suptab3_mrca.nhx.manual_fixes.tree"
    score_table = "/group/esb/cesen/1kp/source_data/1.species_dataset/1kp_paper_2019_suptab1_species.tsv"
    max_a = 4
    max_older = 2
    older_clades = 3
    min_species = 3
    busco_weight = 0.8
    transrate_weight = 0.2
    // Keep only the first N datasets of the generated list, for a quick end-to-end test; null = full run
    test_max_datasets = null

    // ---- ksrates: container, code and Ks database
    // Container image, plus the local ksrates checkout put first on PYTHONPATH inside it so the not-yet-released
    // code (unified Ks database) is used instead of the older code baked into the image. Set ksrates_code_dir
    // to null once an image built from the current code is used.
    ksrates_sif = '/group/esb/cesen/1kp/software/ksrates_a6822fe_20261007.sif'
    ksrates_code_dir = '/group/esb/cesen/1kp/code/ksrates'
    // Full 'ksrates' command line used for init/orthologs-ks/paralogs-ks/check-*-db; null = built by main.nf
    // from ksrates_sif and ksrates_code_dir
    ksrates_command = null
    // Container of the per-dataset ksrates pipelines (stage 4); null = ksrates_sif
    ksrates_container = null
    expert_config = null                // ksrates expert config; must set use_ks_database_server = yes
    ks_database_server_address_path = null   // address file of the running Ks database server
    // Nextflow config with the resources (memory, CPUs) of the per-dataset ksrates pipelines (stage 4); copy and edit
    // ksrates_run.config for an analysis that needs different ones
    ksrates_run_config = "${projectDir}/ksrates_run.config"

    // ---- Which analyses to set up (written into every generated ksrates config)
    paranome = "yes"
    collinearity = "no"                 // not usable on transcriptome-only species
    reciprocal_retention = "no"
    gff_feature = "mrna"
    gff_attribute = "id"
    pair_scope = "init-pairs"
    max_outgroups = 4
    consensus_mode = "mean among outgroups"
    num_bootstrap_iterations = 200
    max_ks_paralogs = "5"
    max_ks_orthologs = "10"
    keep_relative_paths = false

    // ---- Threads given to each wgd job; they are also the CPUs requested for runParalogJob/runOrthologJob
    paralog_threads = 4
    ortholog_threads = 4
    // Concurrent 'ksrates check-*-db' calls while building the command files; null = the CPUs the script
    // may use, up to 16
    db_check_workers = null

    // ---- Stages. Usually chosen per run on the command line, e.g. --run_init --execute_paralog_jobs
    // Execute 'ksrates init' for every generated config inline. Off by default: far too slow for all
    // ~2354 real datasets; init_commands.sh is generated either way, to be run split across parallel jobs.
    run_init = false
    // Submit orthologs_ks_commands.sh / paralogs_ks_commands.sh as native Nextflow jobs (slurm)
    execute_ortholog_jobs = false
    execute_paralog_jobs = false
    // Stage 4: run the per-(dataset, focal) ksrates pipeline once the shared Ks data has been populated.
    // Deliberately separate from the stages above: run it once you have checked their results.
    execute_real_pipelines = false
    // Local checkout of the ksrates pipeline, not yet "VIB-PSB/ksrates" pulled from GitHub
    ksrates_main_nf = '/group/esb/cesen/1kp/code/ksrates/main.nf'
}

// Host-side steps that only run light Python scripts (not inside the ksrates container) run locally;
// the compute-heavy steps are submitted as their own jobs. Resources and concurrency are set here
// and are what to raise for a real run.
executor {
    name = 'local'
}

process {
    // Light Python scripts run on the machine hosting Nextflow, in this Python environment
    withName: 'generateSpeciesMetadata|generateDatasetList|prepareConfigs' {
        executor = 'local'
        beforeScript = 'module load python/x86_64/3.11.4 && source /group/esb/cesen/.venv/venv_python_11/bin/activate'
    }

    // One job per unique ortholog pair (orthologs-ks + orthologs-analysis)
    withName: 'runOrthologJob' {
        executor = 'slurm'
        // A failing pair (e.g. too divergent for max_ks_orthologs) must not abort the whole batch; rerun
        // with -resume later to retry only the failed ones, or accept them as uncomputable.
        errorStrategy = 'ignore'
        maxForks = 25                       // jobs running at the same time
        cpus = { params.ortholog_threads }  // keep equal to the --n-threads of the generated commands
        memory = '4GB'
    }

    // One job per unique paralog species (paralogs-ks); the heavier of the two
    withName: 'runParalogJob' {
        executor = 'slurm'
        errorStrategy = 'ignore'
        maxForks = 25
        cpus = { params.paralog_threads }
        memory = '8GB'
    }

    // One job per (dataset, focal species): launches a ksrates Nextflow pipeline, which submits its own jobs
    withName: 'runRealPipeline' {
        executor = 'slurm'
        errorStrategy = 'ignore'
        maxForks = 25
        time = '04:00:00'
        memory = '2GB'
        beforeScript = 'module load nextflow'
    }
}
