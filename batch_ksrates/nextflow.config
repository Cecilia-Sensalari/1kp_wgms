// All three processes in this pipeline are lightweight Python script invocations (file I/O,
// simple templating, no heavy compute) - the actual expensive work (wgd pipelines) happens in
// later, not-yet-built stages, which will use the slurm executor instead.
executor {
    name = 'local'
}

// Nothing in this pipeline runs inside Singularity directly - containerization is handled
// entirely via the --ksrates_command string passed to prepare_branch_ksrates_configs.py, which
// builds its own "singularity exec ..." invocations internally.
