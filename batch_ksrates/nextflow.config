// Default configuration of the batch_ksrates wrapper (main.nf). main.nf contains only the logic:
// every parameter and every process setting lives here.
//
// To adapt it for one analysis, do NOT edit this file:
// put a nextflow.config in the directory the pipeline is launched from, containing only what differs.
// Nextflow loads it automatically and it overrides the defaults below. Order of priority, highest
// first: command-line --params, -c files, nextflow.config in the launch directory, this file.

params {

    // ---- Required (set them in the analysis' own nextflow.config) ----

    base_dir = null
    // output base directory of the analysis

    transcriptomes_dir = "/path/to/1kp/source_data/2.transcriptomes/1kp/cngb_transcriptomes"
    // directory with the transcriptome FASTA files, one per sample ID

    genome_manifest = "/path/to/1kp/source_data/2.genomes/1kp/genome_species_manifest.tsv"
    // table listing the genome species (column species_id) with the paths of their CDS FASTA and GFF files; the genome
    // species are the species of the tree that have no transcriptome

    container_mounts = ['/path/to/1kp']
    // Folders mounted in every container the wrapper starts: the ksrates commands (init, Ks jobs, database checks) and the
    // per-dataset ksrates pipelines. Everything the containers read or write (inputs, outputs, ksrates code, Ks database)
    // has to be inside one of them. The generated ksrates_run.nextflow.config of the pipelines is built from this list.


    // ---- Inputs of generate_species_metadata.py and make_branch_subtrees.py ----

    genome_gff_settings = "/path/to/1kp/source_data/2.genomes/1kp/genome_gff_settings.tsv"
    // GFF feature and attribute that identify the genes of each genome species (written into its ksrates config);
    // empty for a genome without GFF

    species_table = "/path/to/1kp/source_data/1.species_dataset/1kp_paper_2019_suptab1_species.tsv"
    // 1KP species table: sample ID -> latin name

    tree = "/path/to/1kp/source_data/3.phylogenetic_tree/1kp_trees/astral_trees_33_percent-FAA_estimated_species_tree.rooted.wgm_suptab3_mrca.nhx.manual_fixes.tree"
    // backbone species tree from which the datasets (subtrees) are cut

    score_table = "/path/to/1kp/source_data/1.species_dataset/1kp_paper_2019_suptab1_species.tsv"
    // table with the BUSCO and TransRate quality of each species (used to choose representatives)

    genome_busco_table = "/path/to/1kp/source_data/2.genomes/1kp/genome_busco/genome_busco_scores.tsv"
    // BUSCO (complete+fragmented, eukaryota_odb9) of the genome species, which have no score in score_table;
    // they are scored by BUSCO percentile alone

    max_a = 4
    // max species taken from clade A, the clade below the branch that defines a dataset

    max_older = 2
    // max species taken from each older sibling clade (B, C, D...)

    older_clades = 3
    // number of progressively older sibling clades (B, C, D...) added to each dataset as outgroups

    min_species = 3
    // datasets with fewer species than this are skipped

    busco_weight = 0.8
    // weight of the BUSCO percentile in the species quality score used to pick representatives

    transrate_weight = 0.2
    // weight of the TransRate percentile in that same quality score

    dataset_list = null
    // Table of datasets (subtree_datasets.tsv) used as it is, which skips the generation of the datasets (slow);
    // null = generate it in this run

    test_last_datasets = null
    // Use only the last N datasets of that table (it follows the tree traversal), for a quick test on one part of the
    // tree; null = all datasets

    excluded_nodes = null
    // Nodes that none of the SLURM jobs may run on (--exclude): the jobs of the wrapper and those of the ksrates pipelines.
    // ['mynode1', 'mynode2']; [] or null = any node

    test_skip_last_datasets = null
    // With test_last_datasets = N: leave out the last S datasets first and use the N before them (N = 2, S = 2: the third and
    // fourth to last); null = leave out none

    test_max_datasets = null
    // Keep only the first N datasets when the list is generated in this run (ignored if dataset_list is set); null = full run


    // ---- ksrates: container, code and Ks database ----

    ksrates_sif = '/path/to/1kp/software/ksrates.sif'
    // Container image

    ksrates_code_dir = '/path/to/1kp/code/ksrates'
    // Local ksrates checkout put first on PYTHONPATH inside the container, so that the not-yet-released code
    // (unified Ks database) is used instead of the older code baked into the image.
    // Set it to null once an image built from the current code is used (no PYTHONPATH workaround).

    ksrates_command = null
    // Full 'ksrates' command line used for init/orthologs-ks/paralogs-ks/check-*-db; null = built by main.nf
    // from ksrates_sif and ksrates_code_dir

    python_command = null
    // Only needed when ksrates_command is set (ksrates without the container): the full command of the python that runs ksrates and
    // has ete3. With the container it is read from the ksrates launcher in the image.

    ksrates_container = null
    // Container of the per-dataset ksrates pipelines (stage 4); null = ksrates_sif

    expert_config = null
    // ksrates expert config; must set use_ks_database_server = yes

    ks_database_server_address_path = null
    // address file of the running Ks database server

    ksrates_pipeline_executor = 'slurm'
    // Executor of the processes of the per-dataset ksrates pipelines (stage 4), which are separate Nextflow runs started by
    // runKsratesPipeline. Their CPUs follow paralog_threads and ortholog_threads.

    ksrates_pipeline_memory = [wgdParalogs: '8GB', wgdOrthologs: '4GB', estimatePeaks: '4GB', paralogsAnalyses: '8GB', plotOrthologDistrib: '2GB']
    // Memory of the processes of those pipelines. The settings of this file do not reach them: the wrapper writes these
    // values into the ksrates_run.nextflow.config that it gives to each pipeline.


    // ---- Which analyses to set up (written into every generated ksrates config) ----

    paranome = "yes"
    // yes/no: whole-paranome paralog Ks analysis

    collinearity = "yes"
    // yes/no: collinearity (anchor pairs) analysis. It needs the GFF of the focal species, so it is written as yes
    // only for the species that have one (the genome species, not Klefl) and as no for all the others, in the column
    // collinearity of species_metadata.tsv

    reciprocal_retention = "no"
    // yes/no: reciprocally retained gene families analysis

    gff_feature = "mrna"
    // GFF feature type (column 3) that marks the sequences, e.g. gene or mrna; only a fallback for species without
    // their own gff_feature in species_metadata.tsv

    gff_attribute = "id"
    // GFF attribute (column 9) that holds the sequence ID; only a fallback for species without their own gff_attribute

    pair_scope = "init-pairs"
    // init-pairs = every ortholog pair listed by ksrates init; target-trios = only pairs of focal, target and outgroup species

    max_outgroups = 4
    // max number of outgroup species used to rate-adjust each divergence (ksrates max_number_outgroups)

    consensus_mode = "mean among outgroups"
    // how the Ks estimates from several outgroups are combined (ksrates consensus_mode_for_multiple_outgroups)

    num_bootstrap_iterations = 200
    // bootstrap iterations used to estimate each ortholog Ks peak and its error

    max_ks_paralogs = "5"
    // highest Ks of paralog pairs that is kept

    max_ks_orthologs = "10"
    // highest Ks of ortholog pairs that is kept to estimate the peak

    keep_relative_paths = false
    // true = keep relative FASTA/GFF paths as written; false = resolve them relative to species_metadata.tsv

    divergence_palette = "LightCoral, Red, RoyalBlue, MediumBlue, Goldenrod, #A0720A"
    // Colours of the divergence lines in the Ks plots, by the role of the divergence node in the tested branch, in this order:
    // inside A below the tested node (light, only when A has more than two species), inside A (the tested node), inside B,
    // A|B, inside C, (A+B)|C. The same divergence then has the same colour in every plot of the branch.
    // The split of the outgroup D (the root of the dataset tree) is not drawn by ksrates. Matplotlib colour names or #RRGGBB.


    // ---- Threads given to each wgd job; they are also the CPUs requested for runParalogJob/runOrthologJob ----

    paralog_threads = 4

    ortholog_threads = 4

    db_check_workers = null
    // Concurrent 'ksrates check-*-db' calls while building the command files; null = the CPUs the script
    // may use, up to 16


    // ---- Stages. Usually chosen per run on the command line, e.g. --run_init --execute_paralog_jobs ----

    run_init = false
    // Run 'ksrates init' (one job per config whose init output is missing) and then collect the ortholog pairs
    // from it. The ortholog jobs need these pairs, so it has to be on until init has been run for all configs.

    execute_ortholog_jobs = false
    execute_paralog_jobs = false
    // Run the ortholog Ks jobs (one per queued pair) and the paralog Ks jobs (one per queued species) as Nextflow jobs (slurm)

    execute_ksrates_pipelines = false
    // Stage 4: run the per-(dataset, focal) ksrates pipeline once the shared Ks data has been populated.
    // Deliberately separate from the stages above: run it once you have checked their results.

    draw_branch_trees = true
    // Draw, for every tested branch, the tree with the focal branch in red and the species names coloured by role, next to the
    // Ks plots of each run: rate_adjustment/<focal>/tree_<focal>.b<branch>.pdf.

    draw_branch_distance_trees = true
    // Draw, for every tested branch, the tree with branch lengths in Ks units (ksrates plot-tree) with the focal branch highlighted:
    // rate_adjustment/<focal>/tree_<focal>_distances.b<branch>.pdf. Runs after the ksrates pipelines (needs their rate-adjustment
    // results; with execute_ksrates_pipelines = false it uses those of an earlier launch). Needs expert_config.

    ksrates_main_nf = '/path/to/1kp/code/ksrates/main.nf'
    // Local checkout of the ksrates pipeline, not yet "VIB-PSB/ksrates" pulled from GitHub
}

// One line per ended task in trace/trace_<date>_<time>.tsv of the launch folder, to follow a run in a compact way
// (others/nextflow_progress.sh summarises it per process); the console output has no progress bars, see the launcher
trace {
    enabled = true
    file = "trace/trace_${new Date().format('yyyyMMdd_HHmmss')}.tsv"
    fields = 'task_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss'
}

// Host-side steps that only run light Python scripts (not inside the ksrates container) run locally;
// the compute-heavy steps are submitted as their own jobs. Resources and concurrency are set here
// and are what to raise for a real run.
executor {
    name = 'local'
}

process {

    // Keep every SLURM job away from the nodes of excluded_nodes (no effect on the jobs that run locally)
    clusterOptions = { params.excluded_nodes ? "--exclude=${params.excluded_nodes.join(',')}" : '' }

    // Light steps: they run on the machine hosting Nextflow, but their Python scripts run in the ksrates container (see python_exec in main.nf)
    withName: 'generateSpeciesMetadata|generateDatasetList|makeFocalColorings|prepareConfigs|collectOrthologPairs' {
        executor = 'local'
    }


    // One job per (dataset, focal species) config whose ksrates init output is missing
    withName: 'runInit' {
        executor = 'slurm'

        errorStrategy = 'ignore'
        // A failing init leaves that config without ortholog pairs (the second pass of the config script reports
        // it); rerun with -resume later to retry only the failed ones.

        maxForks = 50
        // jobs running at the same time

        cpus = 1

        memory = '2GB'

        time = '00:10:00'
    }


    // One job per unique ortholog pair (orthologs-ks + orthologs-analysis)
    withName: 'runOrthologJob' {
        executor = 'slurm'

        errorStrategy = 'ignore'
        // A failing pair (e.g. too divergent for max_ks_orthologs) must not abort the whole batch; rerun
        // with -resume later to retry only the failed ones, or accept them as uncomputable.

        maxForks = 25
        // jobs running at the same time

        cpus = { params.ortholog_threads }
        // keep equal to the --n-threads of the generated commands

        memory = '4GB'
    }


    // One job per unique paralog species (paralogs-ks); the heavier of the two
    withName: 'runParalogJob' {
        executor = 'slurm'
        errorStrategy = 'ignore'

        maxForks = 25

        cpus = { params.paralog_threads }

        memory = '8GB'
    }


    // One job per dataset: draws the trees of its tested branches (inside the ksrates container)
    withName: 'drawBranchTrees' {
        executor = 'slurm'

        errorStrategy = 'ignore'
        // The trees do not affect the Ks values; a failure only leaves some trees undrawn.

        maxForks = 25

        cpus = 1

        memory = '2GB'
    }

    // One job per dataset: draws the Ks-distance trees of its tested branches (inside the ksrates container)
    withName: 'drawBranchDistanceTrees' {
        executor = 'slurm'

        errorStrategy = 'ignore'
        // The trees do not affect the Ks values; a failure only leaves some trees undrawn.

        maxForks = 25

        cpus = 1

        memory = '4GB'
        // Every plot-tree call loads all ortholog peaks of the Ks database
    }


    // One job per (dataset, focal species): launches a ksrates Nextflow pipeline, which submits its own jobs
    withName: 'runKsratesPipeline' {
        executor = 'slurm'
        errorStrategy = 'ignore'

        maxForks = 25

        time = '04:00:00'

        memory = '2GB'

        beforeScript = 'module load nextflow'
    }
}
